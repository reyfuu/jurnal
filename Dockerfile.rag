FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY cmd/rag ./cmd/rag
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/rag ./cmd/rag

FROM scratch
WORKDIR /app
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/rag /app/rag
ENTRYPOINT ["/app/rag"]
