# Template .env untuk SERVER (jurnal.skinku.id).
# Salin jadi .env di server, lalu isi semua yang bertanda <...>.
# JANGAN pernah commit file .env yang sudah terisi.

APP_NAME="Jurnal AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jurnal.skinku.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# Di produksi cukup catat peringatan ke atas. 'debug' membuat log membengkak.
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Database (dibuat di hPanel → Database → Manajemen) ─────────────────────
# Database ini MILIK JURNAL AI SENDIRI. Jangan diarahkan ke database portal
# B2B — dua aplikasi berbagi satu database akan saling menimpa tabel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u864765086_jurnal
DB_USERNAME=u864765086_jurnal
DB_PASSWORD=<password database>

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ── Akun admin pertama ─────────────────────────────────────────────────────
# WAJIB diisi. Seeder menolak jalan di produksi kalau kosong, memakai sandi
# umum, atau kurang dari 12 karakter — aplikasi ini terbuka di internet dan
# isinya pembukuan klien.
SEED_ADMIN_NAME="Freddie Kashawan"
SEED_ADMIN_EMAIL=<email kamu>
SEED_ADMIN_PASSWORD=<sandi minimal 12 karakter, acak>

# Isi true HANYA kalau ingin klien contoh ikut dibuat untuk uji coba.
SEED_DEMO_CLIENTS=false

# ── Otak AI ────────────────────────────────────────────────────────────────
# Pakai model yang bisa melihat gambar (vision) agar foto struk terbaca.
AI_PROVIDER=openai
AI_MODEL=<id model>
AI_MAX_OUTPUT_TOKENS=4000
AI_REQUEST_TIMEOUT=120
AI_CONNECT_TIMEOUT=10
AI_TOKEN_PARAM=max_tokens

OPENAI_API_KEY=<key>
OPENAI_API_BASE=https://api.openai.com/v1
# Router pihak ketiga (9router/OpenRouter/Groq): ganti dua baris di atas saja,
# AI_PROVIDER tetap 'openai'. BASE diakhiri /v1, tanpa /chat/completions.

# Otak cadangan — dipakai otomatis saat primary gagal/kuota habis.
AI_BACKUP_KEY=
AI_BACKUP_BASE=
AI_BACKUP_MODEL=

INTAKE_MAX_UPLOAD_KB=12288
